{
  "rules": {
    "players": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['name', 'timestamp', 'status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'game')"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "invites": {
      "$receiverId": {
        ".read": "$receiverId === auth.uid",
        "$senderId": {
          ".write": "$senderId === auth.uid",
          ".validate": "newData.hasChildren(['from', 'fromId', 'roomId', 'timestamp'])",
          "from": {
            ".validate": "newData.isString()"
          },
          "fromId": {
            ".validate": "newData.isString() && newData.val() === $senderId"
          },
          "roomId": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "games": {
      "$roomId": {
        ".read": "root.child('games').child($roomId).child('players').child(auth.uid).exists()",
        ".write": false,
        "gameState": {
          ".write": "root.child('games').child($roomId).child('players').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['board', 'turn', 'history', 'castling'])",
          "board": {
            ".validate": "newData.hasChildren()"
          },
          "turn": {
            ".validate": "newData.isString() && (newData.val() === 'w' || newData.val() === 'b')"
          },
          "history": {
            ".validate": "newData.hasChildren()"
          },
          "castling": {
            ".validate": "newData.hasChildren(['wK', 'wQ', 'bK', 'bQ'])"
          },
          "capturedByWhite": {
            ".validate": "newData.hasChildren()"
          },
          "capturedByBlack": {
            ".validate": "newData.hasChildren()"
          },
          "gameOver": {
            ".validate": "newData.isBoolean()"
          }
        },
        "players": {
          "$playerId": {
            ".write": "$playerId === auth.uid",
            ".validate": "newData.hasChildren(['name', 'color', 'status'])",
            "name": {
              ".validate": "newData.isString()"
            },
            "color": {
              ".validate": "newData.isString() && (newData.val() === 'w' || newData.val() === 'b')"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'disconnected' || newData.val() === 'left')"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    }
  }
}

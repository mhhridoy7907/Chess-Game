  setupOnlineSync(){
    const gameRef = ref(db, `games/${window.app.roomId}`);
    
    if(window.app.gameUnsubscribe) window.app.gameUnsubscribe();
    
    const playerStatusRef = ref(db, `games/${window.app.roomId}/players/${window.app.playerId}`);
    update(playerStatusRef, { status: 'active', lastUpdate: Date.now() }).catch(err => {
      debugLog(`❌ Player Status Error: ${err.message}`);
    });
    onDisconnect(playerStatusRef).update({ status: 'disconnected', lastUpdate: Date.now() });
    
    debugLog(`👂 Listening to game: ${window.app.roomId}`);
    
    window.app.gameUnsubscribe = onValue(gameRef, (snapshot) => {
      const gameData = snapshot.val();
      if(!gameData || !gameData.gameState) return;
      
      if(gameData.gameState.turn !== window.app.playerColor){
        window.app.gameState.board = gameData.gameState.board.map(row => row.slice());
        window.app.gameState.turn = gameData.gameState.turn;
        window.app.gameState.lastMove = gameData.gameState.lastMove ? 
          {from:{...gameData.gameState.lastMove.from}, to:{...gameData.gameState.lastMove.to}} : null;
        window.app.gameState.history = gameData.gameState.history.slice();
        window.app.gameState.castling = Object.assign({}, gameData.gameState.castling);
        window.app.gameState.enPassant = gameData.gameState.enPassant;
        window.app.gameState.capturedByWhite = gameData.gameState.capturedByWhite.slice();
        window.app.gameState.capturedByBlack = gameData.gameState.capturedByBlack.slice();
        window.app.gameState.gameOver = gameData.gameState.gameOver || false;
        window.app.gameState.selected = null;
        window.app.gameState.legalForSelected = [];
        render();
      }
    }, (err) => {
      debugLog(`❌ Game Sync Error: ${err.message}`);
    });
  },
  
  async syncGameState(){
    if(!window.app.isOnline || !window.app.roomId) return;
    
    const gameRef = ref(db, `games/${window.app.roomId}`);
    
    try {
      await runTransaction(gameRef, (current) => {
        if(current === null) return current;
        
        if(current.gameState && current.gameState.turn !== window.app.playerColor){
          debugLog('⚠️ Invalid move - not your turn!');
          return;
        }
        
        return {
          ...current,
          gameState: {
            board: window.app.gameState.board,
            turn: window.app.gameState.turn,
            lastMove: window.app.gameState.lastMove,
            history: window.app.gameState.history,
            castling: window.app.gameState.castling,
            enPassant: window.app.gameState.enPassant,
            capturedByWhite: window.app.gameState.capturedByWhite,
            capturedByBlack: window.app.gameState.capturedByBlack,
            gameOver: window.app.gameState.gameOver
          }
        };
      });
      
      debugLog(`✓ Move synced`);
      const syncEl = document.getElementById('syncStatus');
      syncEl.style.display = 'block';
      setTimeout(() => { syncEl.style.display = 'none'; }, 1500);
    } catch(err){
      debugLog(`❌ Sync Error: ${err.message}`);
    }
  },
  
  exitGame(){
    debugLog('🚪 Exiting game');
    if(window.app.gameUnsubscribe){
      window.app.gameUnsubscribe();
      window.app.gameUnsubscribe = null;
    }

    if(window.app.isOnline){
      const playerStatusRef = ref(db, `games/${window.app.roomId}/players/${window.app.playerId}`);
      update(playerStatusRef, { status: 'left', leftAt: Date.now() });
      remove(ref(db, `players/${window.app.playerId}`));
    }
    
    window.app.mode = 'menu';
    window.app.isOnline = false;
    window.app.roomId = null;
    window.app.playerColor = null;
    window.app.opponentId = null;
    window.app.opponentName = null;
    document.getElementById('gameContainer').classList.remove('active');
    document.getElementById('overlay').classList.remove('active');
    document.getElementById('startScreen').classList.remove('hidden');
  }
};

/* =========================================================
   CHESS ENGINE
========================================================= */

const GLYPH = {
  wK:'♔', wQ:'♕', wR:'♖', wB:'♗', wN:'♘', wP:'♙',
  bK:'♚', bQ:'♛', bR:'♜', bB:'♝', bN:'♞', bP:'♟'
};

function freshBoard(){
  return [
    ['bR','bN','bB','bQ','bK','bB','bN','bR'],
    ['bP','bP','bP','bP','bP','bP','bP','bP'],
    [null,null,null,null,null,null,null,null],
    [null,null,null,null,null,null,null,null],
    [null,null,null,null,null,null,null,null],
    [null,null,null,null,null,null,null,null],
    ['wP','wP','wP','wP','wP','wP','wP','wP'],
    ['wR','wN','wB','wQ','wK','wB','wN','wR']
  ];
}

let state = null;

function newGameState(){
  return {
    board: freshBoard(),
    turn: 'w',
    selected: null,
    legalForSelected: [],
    lastMove: null,
    history: [],
    capturedByWhite: [],
    capturedByBlack: [],
    castling: { wK:true, wQ:true, bK:true, bQ:true },
    enPassant: null,
    orientation: 'w',
    gameOver: false,
    undoStack: []
  };
}

function cloneState(s){
  return {
    board: s.board.map(row => row.slice()),
    turn: s.turn,
    castling: Object.assign({}, s.castling),
    enPassant: s.enPassant ? {r:s.enPassant.r, c:s.enPassant.c} : null,
    lastMove: s.lastMove ? {from:{...s.lastMove.from}, to:{...s.lastMove.to}} : null,
    capturedByWhite: s.capturedByWhite.slice(),
    capturedByBlack: s.capturedByBlack.slice(),
    history: s.history.slice()
  };
}

const boardEl = document.getElementById('chessboard');
const statusEl = document.getElementById('status');
const moveHistoryEl = document.getElementById('moveHistory');
const moveCountEl = document.getElementById('moveCount');
const capturedByWhiteEl = document.getElementById('capturedByWhite');
const capturedByBlackEl = document.getElementById('capturedByBlack');
